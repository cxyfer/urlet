# Build context exclusions: keep the image build fast and reproducible.
.git
.gitignore
.github
target
.cargo-home
# Task worktrees live here by project convention; each carries its own target/,
# so leaving them in the context would ship gigabytes the build never reads.
.worktrees
.tmp
data
docs
# The published documentation site. It is a separate static artifact with its
# own build; the binary never reads it, and its node_modules would otherwise
# dominate the context.
docs-site
scripts
*.db
*.db-wal
*.db-shm
.env
.env.local
Dockerfile
docker-compose*.yml
README.md
LICENSE
