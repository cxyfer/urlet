# ---------------------------------------------------------------------------
# urlet configuration (all values are optional; defaults shown in comments)
# ---------------------------------------------------------------------------

# Public base URL of this instance. Used to build short links, to validate
# same-origin requests (CSRF) and to decide whether cookies are Secure.
URLET_BASE_URL=http://localhost:8080

# Address the HTTP server listens on.
URLET_BIND=0.0.0.0:8080

# SQLite database. Inside docker compose the volume is mounted at /data.
URLET_DATABASE_URL=sqlite:///data/urlet.db?mode=rwc

# HMAC secret used for session/IP hashing and unlock cookies.
# Leave empty to auto-generate one into the data directory on first start.
URLET_SECRET=

# Bootstrap administrator. Both values must be non-empty for this to run; the
# account is created when it does not exist yet, and merely promoted to
# administrator otherwise (its existing password is left untouched).
URLET_ADMIN_EMAIL=admin@example.com
URLET_ADMIN_PASSWORD=change-me-please

# Registration policy override: open | invite | closed
# (empty = use the value stored in the settings table, default: open)
URLET_REGISTRATION=

# Bot protection for the registration, sign-in and short-link creation forms
# (the JSON API register/login endpoints take the token in `captcha_token`).
# Provider: none | turnstile (Cloudflare) | recaptcha (Google reCAPTCHA v2 checkbox).
# Leave the keys empty to disable. The same values can be managed in the admin
# panel (/app/admin/settings); a non-empty environment value overrides it.
URLET_CAPTCHA_PROVIDER=none
URLET_CAPTCHA_SITE_KEY=
URLET_CAPTCHA_SECRET_KEY=
# Apply the challenge to the registration, sign-in and link creation forms.
URLET_CAPTCHA_ON_REGISTER=false
URLET_CAPTCHA_ON_LOGIN=false
URLET_CAPTCHA_ON_CREATE=false

# Extra hostnames whose provider tokens are accepted, comma-separated (up to 10
# bare hostnames). The host of URLET_BASE_URL is always accepted. If this
# instance serves the forms on other hostnames too, list them here, otherwise
# tokens solved there are rejected ("captcha solved but sign-in still fails").
URLET_CAPTCHA_ALLOWED_HOSTNAMES=

# Directory that holds the generated secret. Defaults to the database directory.
# URLET_DATA_DIR=/data

# Optional: target of `urlet healthcheck` (defaults to http://127.0.0.1:<bind port>/health).
# URLET_HEALTHCHECK_URL=http://127.0.0.1:8080/health

# Force the Secure cookie flag. Leave it unset to derive the value from
# URLET_BASE_URL (an https:// base URL implies Secure); set it explicitly only
# to override that derivation.
# URLET_SECURE_COOKIES=false

# Trust X-Forwarded-For / X-Forwarded-Proto (enable behind a reverse proxy).
URLET_TRUST_PROXY=false

# Session lifetime in hours and short-link unlock lifetime in minutes.
URLET_SESSION_TTL_HOURS=168
URLET_UNLOCK_TTL_MINUTES=30

# Logging: level filter and output format (compact | json).
URLET_LOG=info
URLET_LOG_FORMAT=compact

# Automatic slug length (4-16). Empty = use the settings table value.
URLET_DEFAULT_SLUG_LENGTH=

# --- Read by docker compose only; the urlet binary ignores all of them. ---
# Host port that docker-compose.yml publishes (the container always listens on 8080).
# URLET_PORT=8080
# Domain that the docker-compose.tls.yml overlay requests a certificate for.
# URLET_DOMAIN=s.example.com
# Image used by the docker-compose.image.yml overlay; pin a release in production.
# URLET_IMAGE=ghcr.io/cxyfer/urlet:1.1.0
