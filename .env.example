# ---------------------------------------------------------------------------
# uwurls configuration (all values are optional; defaults shown in comments)
# ---------------------------------------------------------------------------

# Public base URL of this instance. Used to build short links, to validate
# same-origin requests (CSRF) and to decide whether cookies are Secure.
UWURLS_BASE_URL=http://localhost:8080

# Address the HTTP server listens on.
UWURLS_BIND=0.0.0.0:8080

# SQLite database. Inside docker compose the volume is mounted at /data.
UWURLS_DATABASE_URL=sqlite:///data/uwurls.db?mode=rwc

# HMAC secret used for session/IP hashing and unlock cookies.
# Leave empty to auto-generate one into the data directory on first start.
UWURLS_SECRET=

# Bootstrap administrator (only applied when the account does not exist yet).
UWURLS_ADMIN_EMAIL=admin@example.com
UWURLS_ADMIN_PASSWORD=change-me-please

# Registration policy override: open | invite | closed
# (empty = use the value stored in the settings table, default: open)
UWURLS_REGISTRATION=

# Bot protection for the registration and short-link creation forms.
# Provider: none | turnstile (Cloudflare) | recaptcha (Google reCAPTCHA v2 checkbox).
# Leave the keys empty to disable. The same values can be managed in the admin
# panel (/app/admin/settings); a non-empty environment value overrides it.
UWURLS_CAPTCHA_PROVIDER=none
UWURLS_CAPTCHA_SITE_KEY=
UWURLS_CAPTCHA_SECRET_KEY=
# Apply the challenge to the registration form and to link creation.
UWURLS_CAPTCHA_ON_REGISTER=false
UWURLS_CAPTCHA_ON_CREATE=false

# Directory that holds the generated secret. Defaults to the database directory.
# UWURLS_DATA_DIR=/data

# Optional: target of `uwurls healthcheck` (defaults to http://127.0.0.1:<bind port>/health).
# UWURLS_HEALTHCHECK_URL=http://127.0.0.1:8080/health

# Set to true when running behind a TLS terminating reverse proxy.
UWURLS_SECURE_COOKIES=false

# Trust X-Forwarded-For / X-Forwarded-Proto (enable behind a reverse proxy).
UWURLS_TRUST_PROXY=false

# Session lifetime in hours and short-link unlock lifetime in minutes.
UWURLS_SESSION_TTL_HOURS=168
UWURLS_UNLOCK_TTL_MINUTES=30

# Logging: level filter and output format (compact | json).
UWURLS_LOG=info
UWURLS_LOG_FORMAT=compact

# Automatic slug length (4-16). Empty = use the settings table value.
UWURLS_DEFAULT_SLUG_LENGTH=
